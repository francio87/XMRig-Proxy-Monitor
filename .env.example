# TLS upstream pool used by the development XMRig Proxy.
# Set a real wallet/user before starting the proxy.
# The first URL is primary; HashVault and SupportXMR are TLS failover pools.
XMRIG_UPSTREAM_URL=gulf.moneroocean.stream:20128
XMRIG_UPSTREAM_HASHVAULT_URL=pool.hashvault.pro:443
XMRIG_UPSTREAM_SUPPORTXMR_URL=pool.supportxmr.com:443
XMRIG_UPSTREAM_USER=CHANGE_ME
XMRIG_UPSTREAM_PASSWORD=x
XMRIG_COIN=monero

# Credentials to enter in the WebUI configuration screen.
XMRIG_API_PORT=18080
XMRIG_API_TOKEN=xmrig-proxy-dev-token-change-me

# Standard Compose binds all services to localhost by default. Change these
# only for a trusted LAN deployment; browsers must reach both WebUI and API.
WEBUI_PORT=4173
WEBUI_BIND=127.0.0.1
XMRIG_API_BIND=127.0.0.1

# Local port for test miners. It is bound to 127.0.0.1 only by default.
XMRIG_STRATUM_PORT=3333
XMRIG_STRATUM_BIND=127.0.0.1
