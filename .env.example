# TLS upstream pool used by the development XMRig Proxy.
# Set a real wallet/user before starting the proxy.
XMRIG_UPSTREAM_URL=gulf.moneroocean.stream:20128
XMRIG_UPSTREAM_USER=CHANGE_ME
XMRIG_UPSTREAM_PASSWORD=x
XMRIG_COIN=monero

# Credentials to enter in the WebUI configuration screen.
XMRIG_API_PORT=18080
XMRIG_API_TOKEN=xmrig-proxy-dev-token-change-me

# Local port for test miners. It is bound to 127.0.0.1 only.
XMRIG_STRATUM_PORT=3333
