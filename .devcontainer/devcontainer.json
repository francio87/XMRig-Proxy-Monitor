{
  "name": "XMRig Proxy Monitor",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.yml"
  ],
  "service": "workspace",
  "runServices": ["workspace", "xmrig-proxy"],
  "workspaceFolder": "/workspaces/xmrig-proxy-monitor",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "forwardPorts": [4173],
  "postCreateCommand": "sudo chown -R node:node node_modules && npm ci && npx playwright install chromium",
  "customizations": {
    "vscode": {
      "extensions": ["ms-playwright.playwright"]
    }
  }
}
