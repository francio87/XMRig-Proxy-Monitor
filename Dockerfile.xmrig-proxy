# Pin the official source release: Docker Hub's xmrig/xmrig-proxy:latest is
# currently an obsolete 2.x image and does not expose the /1/* HTTP API.
FROM alpine:3.20 AS build

RUN apk add --no-cache \
    build-base \
    cmake \
    git \
    libuv-dev \
    linux-headers \
    openssl-dev

RUN git clone --depth 1 --branch v6.26.0 \
    https://github.com/xmrig/xmrig-proxy.git /src

WORKDIR /src/build
RUN cmake .. -DWITH_HTTP=ON -DWITH_TLS=ON \
    && cmake --build . --parallel

FROM alpine:3.20

RUN apk add --no-cache ca-certificates jq libstdc++ libuv openssl
COPY --from=build /src/build/xmrig-proxy /usr/local/bin/xmrig-proxy
COPY scripts/xmrig-proxy-entrypoint.sh /usr/local/bin/xmrig-proxy-entrypoint
RUN chmod +x /usr/local/bin/xmrig-proxy-entrypoint

ENTRYPOINT ["/usr/local/bin/xmrig-proxy-entrypoint"]
